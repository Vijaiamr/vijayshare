# ═══════════════════════════════════════════════════════════════════════
#  AIOps — environment configuration
#  Copy to .env and adjust. All values are optional (defaults shown).
# ═══════════════════════════════════════════════════════════════════════

# ── Runtime state ──────────────────────────────────────────────────────
# AIOPS_DB_PATH=state/aiops.db
# AIOPS_REPORTS_DIR=reports

# ── Universe ───────────────────────────────────────────────────────────
# Comma-separated NSE symbols (yfinance format). ^NSEI = NIFTY 50 index.
# AIOPS_SYMBOLS=^NSEI,RELIANCE.NS,HDFCBANK.NS,INFY.NS,TCS.NS,ICICIBANK.NS,SBIN.NS,BHARTIARTL.NS,ITC.NS,LT.NS,KOTAKBANK.NS

# ── OpenCode LLM bridge ────────────────────────────────────────────────
# Path to the opencode binary (opencode serve must be running).
# OPENCODE_BIN=/Users/vijaykumar/.opencode/bin/opencode
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=            # set when starting `opencode serve --port 4096`
# OPENCODE_MODEL=                      # leave empty to use the server default model
# OPENCODE_AGENT=aiops-llm             # zero-tool reasoning subagent (share/.opencode/agents/aiops-llm.md)

# ── ADK Web UI ─────────────────────────────────────────────────────────
# URL of the ADK web UI (served by `aiops serve`). Returned by the status API.
# ADK_UI_URL=http://127.0.0.1:8011

# ── Local HTTP API ─────────────────────────────────────────────────────
# AIOPS_API_HOST=127.0.0.1
# AIOPS_API_PORT=8010

# ── Temporal discipline (IST) ──────────────────────────────────────────
# PREDICT_AT=09:00          # prediction timestamp on trading day D
# MORNING_DATA_AS_OF=16:00  # D-1 16:00 — features may only use bars through D-1 close
# VALIDATE_AT=16:00         # validation timestamp on trading day D (D close available)

# ── Learning ───────────────────────────────────────────────────────────
# MIN_LESSON_OBSERVATIONS=3
# BACKTEST_DEFAULT_DAYS=15