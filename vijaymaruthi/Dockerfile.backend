FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy backend code
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the analysis engine and API
COPY technical_analysis_report.py .
COPY analysis_db.py .
COPY portfolio_heatmap.py .
COPY quantamental_backtester.py .
COPY sentiment_analyzer.py .
COPY backend/ ./backend/

# Create reports directory
RUN mkdir -p reports reports/charts

EXPOSE 8765

CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8765"]
