<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vijaymaruthi.upload-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/vijaykumar/projecs /opencode/share/vijaymaruthi/sync/download_uploads.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vijaykumar/projecs /opencode/share/vijaymaruthi/sync</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Run every 15 minutes so user uploads reach the Mac promptly -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>/Users/vijaykumar/projecs /opencode/share/vijaymaruthi/logs/upload_sync.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vijaykumar/projecs /opencode/share/vijaymaruthi/logs/upload_sync.err.log</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>