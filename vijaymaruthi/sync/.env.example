# ═══════════════════════════════════════════════════════════════════
#  sync_to_supabase.py — configuration template
#  Copy this file to `.env` and fill in your values:
#      cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# Your Supabase project URL — Supabase Dashboard → Settings → API
# Example: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service role key — Supabase Dashboard → Settings → API → service_role
# ⚠️ SECRET — full database access. Never put this in the frontend.
# ⚠️ Never commit .env to git.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token — Supabase Dashboard → Account → Access Tokens →
# Generate new token. Used ONLY by apply_schema_fix.py to run DDL via the
# Management API (PostgREST cannot run DDL). Optional — without it the
# schema-fix tool falls back to a direct Postgres connection.
# SUPABASE_ACCESS_TOKEN=sbp_...

# Optional: default DB path override (leave commented to use the default
# <share>/reports/analysis_history.db)
# DB_PATH=
