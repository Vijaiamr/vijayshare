<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vijaymaruthi.supabase-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/vijaykumar/projecs /opencode/share/vijaymaruthi/sync/sync_to_supabase.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vijaykumar/projecs /opencode/share/vijaymaruthi/sync</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Run daily at 18:45 local time (IST) — after NSE market close -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/vijaykumar/projecs /opencode/share/vijaymaruthi/logs/supabase_sync.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vijaykumar/projecs /opencode/share/vijaymaruthi/logs/supabase_sync.err.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
